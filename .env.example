# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Your LinkedIn login email
LINKEDIN_EMAIL=you@example.com

# Optional: paste your li_at cookie from browser DevTools
# (Application > Cookies > linkedin.com) to skip the login prompt.
LI_AT=

# Do not put your LinkedIn password in this file.
# The local dashboard passes it only for a single job via the environment.
